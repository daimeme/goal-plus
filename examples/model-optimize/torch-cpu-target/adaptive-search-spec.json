{
  "objective": "maximize single-core PyTorch tokens_per_second while preserving the deterministic workload checksum",
  "metric_name": "tokens_per_second",
  "metric_direction": "maximize",
  "source_path": "examples/model-optimize/torch-cpu-target",
  "workspace": {
    "backend": "git_worktree"
  },
  "edit_surface": {
    "allow": [
      "model.py",
      "serving.py"
    ],
    "deny": [
      "benchmark.py",
      "verify.py",
      "single_thread.py",
      "workload.json",
      "cpp_reference/**"
    ]
  },
  "process_verifiers": [
    {
      "name": "torch_cpu_correctness",
      "role": "validity_gate",
      "command": [
        "python",
        "verify.py"
      ],
      "timeout_seconds": 60,
      "resource_lock": "torch-cpu-adaptive-search"
    },
    {
      "name": "torch_cpu_tokens_per_second",
      "role": "ranking_signal",
      "command": [
        "python",
        "benchmark.py"
      ],
      "timeout_seconds": 120,
      "resource_lock": "torch-cpu-adaptive-search"
    }
  ],
  "promotion_verifiers": [
    {
      "name": "torch_cpu_correctness",
      "role": "promotion_gate",
      "command": [
        "python",
        "verify.py"
      ],
      "timeout_seconds": 60,
      "resource_lock": "torch-cpu-adaptive-search"
    }
  ],
  "budget": {
    "max_parallel": 2,
    "max_candidates": 4
  },
  "strategy": {
    "name": "random",
    "orchestration_mode": "adaptive_search",
    "worker_host": "codex",
    "worker_budget": {
      "max_runtime_seconds": 360,
      "on_exceed": "interrupt"
    },
    "adaptive_search": {
      "reward": {
        "name": "metric_progress",
        "version": 2,
        "params": {
          "epsilon": 1e-09,
          "reward_clip": 4.0,
          "value_scale": 1.0,
          "quality_weight": 1.0,
          "regression_weight": 1.25,
          "failure_penalty": 1.0,
          "cost_weight": 0.0,
          "cost_scale_seconds": 60.0
        }
      },
      "value_backup": {
        "name": "discounted_mean_best",
        "version": 1,
        "params": {
          "discount": 0.9,
          "attempt_reward_weight": 0.5,
          "best_weight": 0.25
        }
      },
      "allocation": {
        "name": "value_guided_replace",
        "version": 1,
        "params": {
          "min_attempts": 3,
          "window_size": 2,
          "retire_threshold": 0.08,
          "exploration_weight": 0.05,
          "uncertainty_weight": 1.0,
          "nonpositive_fraction": 1.0,
          "source_exploration_weight": 0.05
        }
      },
      "expansion": {
        "source_policy": "highest_value",
        "model_policy": "inherit_source",
        "max_depth": 2,
        "worker_budget": {
          "max_runtime_seconds": 300,
          "on_exceed": "interrupt"
        }
      }
    },
    "config": {
      "seed": 20260819
    }
  },
  "constraints": {
    "suggested_batch_size": 2,
    "task_summary": "Optimize only model.py or serving.py. Keep PyTorch, OpenMP, MKL, and build thread counts at one. Use runtime reward/allocation decisions exactly; retired candidates must not start another iteration."
  }
}
